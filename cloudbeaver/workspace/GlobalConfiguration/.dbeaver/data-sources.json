{
  "folders": {
    "Arkano": {}
  },
  "connections": {
    "postgres-jdbc-arkano-accounts": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "Arkano Accounts DB",
      "save-password": true,
      "show-system-objects": false,
      "folder": "Arkano",
      "user": "postgres",
      "configuration": {
        "host": "accounts-db",
        "port": "5432",
        "database": "accounts",
        "url": "jdbc:postgresql://accounts-db:5432/accounts",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "native",
        "provider-properties": {
          "@dbeaver-show-non-default-db@": "false",
          "@dbeaver-show-template-db@": "false",
          "@dbeaver-show-unavailable-db@": "false"
        }
      }
    },
